POSTGRES_DB=securecode
POSTGRES_USER=securecode
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://securecode:change-this-local-password@localhost:5432/securecode
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=5242880
UPLOAD_DIR=
SCANNER_TIMEOUT_SECONDS=30
AI_PROVIDER=mock
# Generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The API fails closed until a key of at least 32 characters is configured.
API_KEY=
MAX_CONCURRENT_SCANS=2
